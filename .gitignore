# Public repository: source, tests, usage documentation and small fixtures only.
# Ignoring a path does not remove local data. Never use git clean -fdx here.

# Operating-system, editor and agent metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
.agents/
.codex_tmp/
.workbuddy/
~$*

# Credentials and local environment configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Python caches, environments and temporary test workspaces
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/
.ipynb_checkpoints/
/.test_*/
/tests/batch_script_tests/

# CMake and compiler outputs; existing binaries stay in place
/build/
/build_*/
/cmake-build-*/
/.cmake/
/cmake_install.cmake
/Makefile
/Testing/
CMakeCache.txt
CMakeFiles/
compile_commands.json
*.o
*.obj
*.a
*.lib
*.dll
*.exe

# Runtime products and local experiment dependencies
*.log
*.pid
diag_*/
/garbage/
/outputs/
/eval/
/eval_results/
/models/
/models_*/
/training_logs/
/logs/
/tmp/
/baselines/
/Manhattan_Data/
/train_data/
/command/
/tools/maintenance/native_v2_continue_20261004/
/tools/maintenance/native_v2_home_recovery_20261006/
*.pkl
*.joblib

# Generated tables are separate from the catching/ source package
/catch/*
!/catch/README.md

# Only the small static network is a public data fixture
/data/*
!/data/README.md
!/data/net/
/data/net/*
!/data/net/test_new.net.xml
/high.rou.xml
/test.net.xml
/sumo_visual.sumocfg
/manhattan*.sumocfg
/tripinfo*.xml

# Local research notebook, reports, papers and office documents
/PROJECT_MANUAL.md
/Traci.txt
/PROJECT_MILESTONE*.md
/ADVISOR_REPORT*.md
/*.pdf
/*.docx
/docs/*
!/docs/environment.md
!/docs/project_layout.md
!/docs/source_layout.json
!/docs/usage.md

# A nested repository is never imported into this repository
/data/.git/
