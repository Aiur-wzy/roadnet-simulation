* text=auto

# Keep source/configuration files stable across Windows and Linux.
*.cpp text eol=lf
*.h text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.sumocfg text eol=lf

# Binary artifacts and documents must never be line-ending normalized.
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.svg text eol=lf
